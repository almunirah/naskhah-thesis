# Application
NODE_ENV=development
APP_URL=http://localhost:3000

# PostgreSQL
POSTGRES_DB=naskhah_thesis
POSTGRES_USER=naskhah
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql://naskhah:change-me-local-only@localhost:5432/naskhah_thesis?schema=public

# Auth.js (Phase 1)
AUTH_SECRET=replace-with-a-long-random-secret
ALLOW_SELF_REGISTRATION=false

# MinIO / S3-compatible storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=naskhah-thesis
S3_ACCESS_KEY=naskhah
S3_SECRET_KEY=change-me-local-only
S3_FORCE_PATH_STYLE=true
